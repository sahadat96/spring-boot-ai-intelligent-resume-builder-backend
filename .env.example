# --- Application Server & Networking ---
PORT=8080
PUBLIC_URL=https://app.opticareer.com
CORS_ORIGINS=https://app.opticareer.com

# --- PostgreSQL Primary Relational Store ---
DATABASE_URL=jdbc:postgresql://localhost:5432/ai_intelligent_backend
DATABASE_USER=opticareer_app
DATABASE_PASSWORD=your_secure_postgres_password_here
DATABASE_POOL_SIZE=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# --- Redis Distributed Cache & Rate Limiter ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2s

# --- Cryptographic Security Keys ---
# IMPORTANT: Generate independent cryptographically secure 256-bit (32-byte) keys:
# Linux/macOS command: openssl rand -base64 32
JWT_KEY=replace_with_base64_encoded_32_byte_hmac_secret
ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_aes_gcm_secret
ENCRYPTION_KEY_ID=v1
# Optional: comma-separated previous keys for zero-downtime key rotation: v0:BASE64_KEY
PREVIOUS_ENCRYPTION_KEYS=
# Cookie security: false in local development HTTP; MUST BE true in staging/production HTTPS
COOKIE_SECURE=true
JWT_ISSUER=opticareer
GOOGLE_CLIENT_ID=
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=14
BREACHED_PASSWORD_CHECK=true

# --- S3 / MinIO Encrypted Object Storage ---
STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
STORAGE_REGION=us-east-1
STORAGE_BUCKET=opticareer-documents
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
STORAGE_SIGNED_URL_MINUTES=5
MALWARE_SCAN_REQUIRED=true
SCAN_HOST=localhost
SCAN_PORT=3310

# --- AI Gateway & LLM Orchestration ---
AI_ENABLED=false
AI_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o
AI_TIMEOUT_SECONDS=30
AI_MAX_CONCURRENT=4
AI_DAILY_TOKEN_LIMIT=1000000

# --- Stripe Billing & Webhook Integration ---
STRIPE_ENABLED=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASE_URL=https://api.stripe.com
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_SIX_MONTH=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_SIX_MONTH=

# --- Background Worker & Async Queue ---
WORKER_ENABLED=true
WORKER_POLL_MS=1000
WORKER_MAX_ATTEMPTS=5
WORKER_LEASE_SECONDS=120

# --- Email & SMTP Notifications ---
MAIL_FROM=security@opticareer.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_AUTH=true
SMTP_STARTTLS=true

# --- Documentation & Swagger UI ---
API_DOCS_ENABLED=false
SWAGGER_UI_ENABLED=false
